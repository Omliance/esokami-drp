{#
/**
 * @file
 * Theme override for the homepage.
 *
 * Removes sidebars and container constraints so homepage sections
 * can span full width with their own backgrounds.
 */
#}
{# Messages Drupal — hors scope Esokami #}
{% if page.highlighted %}
  <div class="highlighted">
    <aside class="container section clearfix" role="complementary">
      {{ page.highlighted }}
    </aside>
  </div>
{% endif %}

<div id="page-wrapper">
  <div id="page">
    {# Header / Navigation #}
    {% block head %}
      {% if page.secondary_menu or page.top_header or page.top_header_form %}
        <nav{{ navbar_top_attributes }}>
          {% if container_navbar %}
          <div class="container">
          {% endif %}
            {{ page.secondary_menu }}
            {{ page.top_header }}
            {% if page.top_header_form %}
              <div class="form-inline navbar-form ms-auto">
                {{ page.top_header_form }}
              </div>
            {% endif %}
          {% if container_navbar %}
          </div>
          {% endif %}
        </nav>
      {% endif %}
      {% if page.header or page.primary_menu or page.header_form %}
        <header id="header" class="header" role="banner" aria-label="{{ 'Site header'|t }}">
          <nav{{ navbar_attributes }}>
            {% if container_navbar %}
            <div class="container">
            {% endif %}
              {{ page.header }}
              {% if page.primary_menu or page.header_form %}
                <button class="navbar-toggler collapsed" type="button" data-bs-toggle="{{ navbar_collapse_btn_data }}" data-bs-target="#CollapsingNavbar" aria-controls="CollapsingNavbar" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
                <div class="{{ navbar_collapse_class }}" id="CollapsingNavbar">
                  {% if navbar_offcanvas %}
                    <div class="offcanvas-header">
                      <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                    </div>
                    <div class="offcanvas-body">
                  {% endif %}
                  {{ page.primary_menu }}
                  {% if page.header_form %}
                    <div class="form-inline navbar-form justify-content-end">
                      {{ page.header_form }}
                    </div>
                  {% endif %}
                  {% if navbar_offcanvas %}
                    </div>
                  {% endif %}
                </div>
              {% endif %}
            {% if container_navbar %}
            </div>
            {% endif %}
          </nav>
        </header>
      {% endif %}
    {% endblock %}

    {# Main content — full width, no container #}
    <div id="main-wrapper" class="layout-main-wrapper clearfix">
      {% block content %}
        <main role="main">
          <a href="#main-content" id="main-content" tabindex="-1"></a>
          {{ page.content }}
        </main>
      {% endblock %}
    </div>

    {# Featured bottom #}
    {% if page.featured_bottom_first or page.featured_bottom_second or page.featured_bottom_third %}
      <div class="featured-bottom">
        <aside class="clearfix" role="complementary">
          {{ page.featured_bottom_first }}
          {{ page.featured_bottom_second }}
          {{ page.featured_bottom_third }}
        </aside>
      </div>
    {% endif %}

    {# Footer #}
    <footer class="site-footer">
      {% block footer %}
        <div class="container">
          {% if page.footer_first or page.footer_second or page.footer_third or page.footer_fourth %}
            <div class="site-footer__top clearfix">
              {{ page.footer_first }}
              {{ page.footer_second }}
              {{ page.footer_third }}
              {{ page.footer_fourth }}
            </div>
          {% endif %}
          {% if page.footer_fifth %}
            <div class="site-footer__bottom">
              {{ page.footer_fifth }}
            </div>
          {% endif %}
        </div>
      {% endblock %}
    </footer>
  </div>
</div>
