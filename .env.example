# Fichier d'exemple pour les variables d'environnement de production
# Copiez ce fichier en .env et remplissez les valeurs
# ATTENTION : Ne commitez JAMAIS le fichier .env dans Git

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=drupal_prod
DB_USER=drupal_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# =============================================================================
# DRUPAL CONFIGURATION
# =============================================================================
# Générer avec : openssl rand -base64 64 | tr -d "\n"
DRUPAL_HASH_SALT=CHANGE_ME_GENERATE_LONG_RANDOM_STRING

# Patterns d'hôtes de confiance (format regex, séparés par |)
TRUSTED_HOST_PATTERNS=^esokami\\.fr$|^www\\.esokami\\.fr$

# Répertoire de synchronisation de la configuration
CONFIG_SYNC_DIRECTORY=../config/sync

# Chemins des fichiers
FILE_PRIVATE_PATH=/var/www/private
FILE_TEMP_PATH=/tmp

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
# Générer avec : openssl rand -base64 32 | tr -d "=+/" | cut -c1-32
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# =============================================================================
# PHP CONFIGURATION
# =============================================================================
PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=300
PHP_UPLOAD_MAX_FILESIZE=64M
PHP_POST_MAX_SIZE=64M

# =============================================================================
# DOMAIN AND SSL
# =============================================================================
DOMAIN_NAME=esokami.fr
LETSENCRYPT_EMAIL=admin@esokami.fr

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
BACKUP_RETENTION_DAYS=30
