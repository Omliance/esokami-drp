# Core Drupal et dépendances (gérés par Composer)
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/

# Fichiers utilisateur et uploads
/web/sites/*/files/
/web/sites/*/private/
/private/

# Configuration sensible (ne JAMAIS commiter)
/web/sites/*/settings.php
/web/sites/*/settings.local.php
/web/sites/*/services*.yml
!web/sites/*/default.settings.php
!web/sites/*/default.services.yml

# DDEV - garder seulement la config
/.ddev/*
!/.ddev/config.yaml
!/.ddev/.gitignore

# Logs
*.log
/web/sites/*/logs/

# Temporary files
/web/sites/*/tmp/
/tmp/

# IDE
/.idea/
/.vscode/
*.swp
*.swo
*.sublime-*

# OS
.DS_Store
Thumbs.db
._*

# Composer
/composer.phar

# Node
/node_modules/
npm-debug.log*

# Backups
/backups/
*.sql
*.sql.gz
*.dump

# Environment
.env
.env.local